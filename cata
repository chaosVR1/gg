-- Functions
local function tryOn(itemId)
    local id = tonumber(itemId)
    if not id then
        Status.Text = "Invalid ID"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    local success, err = pcall(function()
        local humanoid = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end

        local description = humanoid:GetAppliedDescription()
        description:SetAccessories({}, true) -- optional clear

        -- Apply the asset
        humanoid:ApplyDescriptionReset(description)

        -- Better method using InsertService / HumanoidDescription
        local InsertService = game:GetService("InsertService")
        local asset = InsertService:LoadAsset(id)
        for _, item in ipairs(asset:GetChildren()) do
            if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") then
                item.Parent = LP.Character
            end
        end
        asset:Destroy()
    end)

    if success then
        Status.Text = "Tried on ID: " .. id
        Status.TextColor3 = Color3.fromRGB(80, 255, 120)
    else
        Status.Text = "Failed to try on"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        warn(err)
    end
end

TryOnButton.MouseButton1Click:Connect(function()
    tryOn(ItemIdBox.Text)
end)

ClearButton.MouseButton1Click:Connect(function()
    local humanoid = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:ApplyDescriptionReset(Players:GetHumanoidDescriptionFromUserId(LP.UserId))
        Status.Text = "Cleared"
        Status.TextColor3 = Color3.fromRGB(200, 200, 210)
    end
end)

