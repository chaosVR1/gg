local function makeSlider(parent, label, minV, maxV, defaultV, decimals, suffix, onChange)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 46)
    holder.BackgroundColor3 = T.CardHi
    holder.BorderSizePixel = 0
    holder.Parent = parent
    round(holder, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 16)
    lbl.Position = UDim2.new(0, 10, 0, 5)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextColor3 = T.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = holder

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -34, 0, 4)
    track.Position = UDim2.new(0, 12, 0, 32)
    track.BackgroundColor3 = T.Off
    track.BorderSizePixel = 0
    track.Parent = holder
    round(track, 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = T.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    round(fill, 2)
    gradient(fill, T.Accent, T.Accent2, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.ZIndex = 3
    knob.Parent = track
    round(knob, 6)
    stroke(knob, T.Accent, 2)

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, 0, 0, 24)
    hit.Position = UDim2.new(0, 0, 0, 20)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Parent = holder

    local val = math.clamp(defaultV, minV, maxV)
    local dragging = false

    local function fmt(v)
        local m = 10 ^ decimals
        v = math.floor(v * m + 0.5) / m
        return tostring(v) .. (suffix or "")
    end

    local function paint()
        local t = math.clamp((val - minV) / (maxV - minV), 0, 1)
        fill.Size = UDim2.new(t, 0, 1, 0)
        knob.Position = UDim2.new(t, 0, 0.5, 0)
        lbl.Text = label .. "   " .. fmt(val)
    end

    local function setFromX(px)
        local rel = math.clamp((px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local v = minV + rel * (maxV - minV)
        local m = 10 ^ decimals
        v = math.floor(v * m + 0.5) / m
        if v ~= val then
            val = v
            paint()
            pcall(onChange, v)
        end
    end

    paint()

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    task.spawn(function()
        while holder.Parent do
            RunService.Heartbeat:Wait()
            if dragging then setFromX(UIS:GetMouseLocation().X) end
        end
    end)
end

local function makeDropdown(parent, label, options, defaultOpt, onChange)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 36)
    holder.BackgroundColor3 = T.CardHi
    holder.BorderSizePixel = 0
    holder.Parent = parent
    round(holder, 8)

    local current = defaultOpt
    local open = false
    local listFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.TextColor3 = T.Text
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Text = "  " .. label
    btn.Parent = holder

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 100, 1, 0)
    valLbl.Position = UDim2.new(1, -124, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 12
    valLbl.TextColor3 = T.Accent
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Text = current
    valLbl.Parent = holder

    local function closeList()
        if listFrame then
            listFrame:Destroy()
            listFrame = nil
            open = false
        end
    end

    btn.MouseButton1Click:Connect(function()
        if open then closeList() return end
        open = true
        listFrame = Instance.new("Frame")
        listFrame.Size = UDim2.new(1, 0, 0, math.min(#options, 4) * 30 + 8)
        listFrame.Position = UDim2.new(0, 0, 1, 4)
        listFrame.BackgroundColor3 = T.BG
        listFrame.BorderSizePixel = 0
        listFrame.ZIndex = 10
        listFrame.Parent = holder
        round(listFrame, 8)
        stroke(listFrame, T.Stroke, 1)

        local l = Instance.new("UIListLayout")
        l.Padding = UDim.new(0, 2)
        l.Parent = listFrame
        local p = Instance.new("UIPadding")
        p.PaddingTop = UDim.new(0, 4)
        p.PaddingBottom = UDim.new(0, 4)
        p.PaddingLeft = UDim.new(0, 4)
        p.PaddingRight = UDim.new(0, 4)
        p.Parent = listFrame

        for _, opt in ipairs(options) do
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1, 0, 0, 26)
            ob.BackgroundColor3 = (opt == current) and T.Accent or T.Card
            ob.BackgroundTransparency = (opt == current) and 0 or 0.4
            ob.Font = Enum.Font.GothamMedium
            ob.TextSize = 12
            ob.TextColor3 = (opt == current) and Color3.new(1, 1, 1) or T.SubText
            ob.Text = "  " .. opt
            ob.AutoButtonColor = false
            ob.ZIndex = 11
            ob.Parent = listFrame
            round(ob, 6)
            hoverEffect(ob, ob.BackgroundColor3, T.CardHi)
            ob.MouseButton1Click:Connect(function()
                current = opt
                valLbl.Text = opt
                closeList()
                pcall(onChange, opt)
            end)
        end
    end)
end

