local function switchTab(name)
    for n, btn in pairs(tabButtons) do
        local on = (n == name)
        TweenSvc:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = on and T.CardHi or T.Card,
            TextColor3 = on and T.Text or T.SubText
        }):Play()
        local ind = btn:FindFirstChild("Ind")
        if ind then
            TweenSvc:Create(ind, TweenInfo.new(0.2), {
                BackgroundTransparency = on and 0 or 1,
                Size = on and UDim2.new(0, 3, 0, 14) or UDim2.new(0, 3, 0, 0)
            }):Play()
        end
    end
    for _, page in ipairs(pages:GetChildren()) do
        page.Visible = (page.Name == name)
    end
end

