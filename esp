--═════════════════ SHARED ═════════════════
local HAS_DRAWING = type(Drawing) == "table" and type(Drawing.new) == "function"
local FONT = 2
if HAS_DRAWING then pcall(function() FONT = Drawing.Fonts.Plex end) end

local function newDraw(class, props)
    if not HAS_DRAWING then return nil end
    local ok, obj = pcall(Drawing.new, class)
    if not ok or not obj then return nil end
    if props then
        for k, v in pairs(props) do
            pcall(function() obj[k] = v end)
        end
    end
    return obj
end

local function killDraw(obj)
    if obj then pcall(function() obj:Remove() end) end
end

local function alpha(t)
    return math.clamp(1 - t * 0.01, 0, 1)
end

--═════════════════ PLAYER ESP ═════════════════
local espStore = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = false

local VIS_INTERVAL = 0.35

local function isVisible(char, s)
    if not cfg.UseVisibility then return true end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not Camera then return true end
    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
    if dist < 25 then return true end
    if dist > cfg.MaxDistance * 0.9 then return false end
    if s.lastVisTime and (os.clock() - s.lastVisTime) < VIS_INTERVAL then
        return s.lastVis
    end
    rayParams.FilterDescendantsInstances = {LP.Character, char}
    local result = workspace:Raycast(Camera.CFrame.Position, hrp.Position - Camera.CFrame.Position, rayParams)
    s.lastVis = (result == nil)
    s.lastVisTime = os.clock()
    return s.lastVis
end

local function colorFor(plr, vis)
    if cfg.UseVisibility and vis == false then
        return Color3.fromRGB(255, 85, 85)
    end
    if cfg.ColorMode == "Custom" then
        return cfg.CustomColor
    end
    return plr.Team and plr.TeamColor.Color or Color3.fromRGB(255, 255, 255)
end

local function buildState(plr)
    local s = {
        lastName = "", lastHp = -1, lastDist = -1, lastTool = "",
        lastVis = true, lastVisTime = 0, corner = {},
    }
    s.box    = newDraw("Square", {Filled = false, Visible = false, Thickness = 1.2})
    s.hpBack = newDraw("Square", {Filled = true, Color = Color3.fromRGB(12, 12, 14), Visible = false})
    s.hpFill = newDraw("Square", {Filled = true, Visible = false})
    s.name   = newDraw("Text", {Center = true, Outline = true, Visible = false, Font = FONT, Size = 13})
    s.hpTxt  = newDraw("Text", {Center = true, Outline = true, Visible = false, Font = FONT, Size = 11})
    s.dist   = newDraw("Text", {Center = true, Outline = true, Visible = false, Font = FONT, Size = 11})
    s.tool   = newDraw("Text", {Center = true, Outline = true, Visible = false, Font = FONT, Size = 11})
    s.tracer = newDraw("Line", {Visible = false})
    s.chams  = Instance.new("Highlight")
    s.chams.Name = "_nexus_chams"
    s.chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    s.chams.Enabled = false
    espStore[plr] = s
    return s
end

local function ensureCorners(s)
    if #s.corner >= 8 then return end
    for i = 1, 8 do
        s.corner[i] = newDraw("Line", {Visible = false, Thickness = 1.2})
    end
end

local function hide(s)
    if not s then return end
    if s.box then s.box.Visible = false end
    if s.hpBack then s.hpBack.Visible = false end
    if s.hpFill then s.hpFill.Visible = false end
    if s.name then s.name.Visible = false end
    if s.hpTxt then s.hpTxt.Visible = false end
    if s.dist then s.dist.Visible = false end
    if s.tool then s.tool.Visible = false end
    if s.tracer then s.tracer.Visible = false end
    for i = 1, #s.corner do
        if s.corner[i] then s.corner[i].Visible = false end
    end
    if s.chams then s.chams.Enabled = false end
end

local function destroyState(plr)
    local s = espStore[plr]
    if not s then return end
    killDraw(s.box) killDraw(s.hpBack) killDraw(s.hpFill)
    killDraw(s.name) killDraw(s.hpTxt) killDraw(s.dist)
    killDraw(s.tool) killDraw(s.tracer)
    for i = 1, #s.corner do killDraw(s.corner[i]) end
    pcall(function() s.chams:Destroy() end)
    espStore[plr] = nil
end

local function drawCorners(x, y, w, h, len, col, a, th, s)
    ensureCorners(s)
    local cs = {
        {x, y, x+len, y, x, y, x, y+len},
        {x+w-len, y, x+w, y, x+w, y, x+w, y+len},
        {x, y+h-len, x, y+h, x, y+h, x+len, y+h},
        {x+w-len, y+h, x+w, y+h, x+w, y+h-len, x+w, y+h},
    }
    for ci = 1, 4 do
        local cd = cs[ci]
        for li = 1, 2 do
            local line = s.corner[(ci-1)*2 + li]
            if line then
                local i2 = (li-1)*2 + 1
                line.From = Vector2.new(cd[i2], cd[i2+1])
                line.To   = Vector2.new(cd[i2+2], cd[i2+3])
                line.Color = col
                line.Thickness = th
                line.Transparency = a
                line.Visible = true
            end
        end
    end
end

--═════════════════ OBJECT ESP ═════════════════
local objStore = {}
local objects = {}

local TARGETS = {
    ["Landmine"] = "mine",
    ["Remote explosive"] = "remote",
    ["Remote Explosive"] = "remote",
    ["C4"] = "remote",
    ["Bomb"] = "remote",
}

local function getPart(obj)
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChild("Handle")
        or obj:FindFirstChild("Bomb")
        or obj:FindFirstChild("Landmine")
        or obj:FindFirstChildWhichIsA("BasePart")
end

local function buildObj(obj)
    local s = {
        box  = newDraw("Square", {Filled = false, Thickness = 1.3, Visible = false}),
        name = newDraw("Text", {Center = true, Outline = true, Size = cfg.ObjectTextSize, Font = FONT, Visible = false}),
        dist = newDraw("Text", {Center = true, Outline = true, Size = cfg.ObjectTextSize - 2, Font = FONT, Visible = false}),
    }
    objStore[obj] = s
    return s
end

local function hideObj(s)
    if not s then return end
    s.box.Visible = false
    s.name.Visible = false
    s.dist.Visible = false
end

local function destroyObj(obj)
    local s = objStore[obj]
    if not s then return end
    killDraw(s.box) killDraw(s.name) killDraw(s.dist)
    objStore[obj] = nil
end

local function refreshObjects()
    local found = {}
    local function check(obj)
        local kind = TARGETS[obj.Name]
        if kind then
            local part = getPart(obj)
            if part then
                found[obj] = {part = part, kind = kind}
            end
        end
    end

    for _, obj in ipairs(workspace:GetChildren()) do
        check(obj)
        for _, child in ipairs(obj:GetChildren()) do
            check(child)
        end
    end

    for obj in pairs(objStore) do
        if not found[obj] then destroyObj(obj) end
    end
    objects = found
end

--═════════════════ MAIN LOOP ═════════════════
local playerCache = {}
local cacheTimer = 0
local updateTimer = 0
local objScanTimer = 0
local TARGET_HZ = 40

local connection = RunService.Heartbeat:Connect(function(dt)
    if not Camera or not Camera.Parent then
        Camera = workspace.CurrentCamera
        if not Camera then return end
    end

    -- Player list cache
    cacheTimer = cacheTimer + dt
    if cacheTimer >= 0.2 then
        cacheTimer = 0
        playerCache = Players:GetPlayers()
    end

    -- Object scan (very light)
    objScanTimer = objScanTimer + dt
    if objScanTimer >= 0.8 then
        objScanTimer = 0
        if cfg.ObjectESP then
            refreshObjects()
        end
    end

    updateTimer = updateTimer + dt
    if updateTimer < (1 / TARGET_HZ) then return end
    updateTimer = 0

    local camPos = Camera.CFrame.Position
    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local vp = Camera.ViewportSize
    local a = alpha(cfg.BoxTransparency)
    local tA = alpha(cfg.TextTransparency)

    --===== PLAYER ESP =====
    if cfg.Enabled then
        for i = 1, #playerCache do
            local plr = playerCache[i]
            if plr == LP then continue end

            local s = espStore[plr] or buildState(plr)
            local char = plr.Character
            if not char then hide(s) continue end

            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp or hum.Health <= 0 or not char.Parent then
                hide(s) continue
            end

            if cfg.TeamCheck and LP.Team and plr.Team == LP.Team then
                hide(s) continue
            end

            local dist = myHrp and (myHrp.Position - hrp.Position).Magnitude or (camPos - hrp.Position).Magnitude
            if dist > cfg.MaxDistance then hide(s) continue end

            local rootSP, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if rootSP.Z < 1 or not onScreen then hide(s) continue end

            local vis = isVisible(char, s)
            local col = colorFor(plr, vis)

            local head = char:FindFirstChild("Head") or hrp
            local headSP = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.4, 0))
            local feetSP = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.8, 0))

            local scale = 200 / rootSP.Z
            local bw = math.clamp(36 * scale, 6, 80)
            local bh = math.clamp(58 * scale, 12, 130)
            local bx = rootSP.X - bw * 0.5
            local by = rootSP.Y - bh * 0.55

            if cfg.Chams then
                local chA = alpha(cfg.ChamsTransparency)
                if s.chams.Parent ~= char then s.chams.Parent = char end
                s.chams.Adornee = char
                s.chams.FillColor = col
                s.chams.OutlineColor = col
                s.chams.FillTransparency = chA
                s.chams.OutlineTransparency = math.max(chA - 0.3, 0)
                s.chams.Enabled = true
            else
                s.chams.Enabled = false
            end

            if not HAS_DRAWING then continue end

            if cfg.BoxStyle == "Full" then
                s.box.Size = Vector2.new(bw, bh)
                s.box.Position = Vector2.new(bx, by)
                s.box.Color = col
                s.box.Thickness = cfg.BoxThickness
                s.box.Transparency = a
                s.box.Visible = true
                for i = 1, #s.corner do if s.corner[i] then s.corner[i].Visible = false end end
            elseif cfg.BoxStyle == "Corner" then
                local len = math.clamp(math.max(bw, bh) * 0.2, 3, 11)
                drawCorners(bx, by, bw, bh, len, col, a, cfg.BoxThickness, s)
                s.box.Visible = false
            else
                s.box.Visible = false
                for i = 1, #s.corner do if s.corner[i] then s.corner[i].Visible = false end end
            end

            if cfg.ShowHealth then
                local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                local barW = 3
                local barX = bx - barW - 2
                s.hpBack.Size = Vector2.new(barW, bh)
                s.hpBack.Position = Vector2.new(barX, by)
                s.hpBack.Transparency = math.min(a + 0.3, 1)
                s.hpBack.Visible = true
                s.hpFill.Size = Vector2.new(barW, bh * frac)
                s.hpFill.Position = Vector2.new(barX, by + bh * (1 - frac))
                s.hpFill.Color = Color3.fromHSV(0.33 * frac, 0.85, 1)
                s.hpFill.Transparency = a
                s.hpFill.Visible = true
            else
                s.hpBack.Visible = false
                s.hpFill.Visible = false
            end

            if cfg.ShowName and headSP.Z > 0 then
                local nameStr = plr.DisplayName
                if s.lastName ~= nameStr then s.name.Text = nameStr s.lastName = nameStr end
                s.name.Position = Vector2.new(headSP.X, headSP.Y - cfg.TextSize - 2)
                s.name.Size = cfg.TextSize
                s.name.Color = col
                s.name.Transparency = tA
                s.name.Visible = true
            else
                s.name.Visible = false
            end

            if cfg.ShowHealthText and headSP.Z > 0 then
                local hp = math.floor(hum.Health + 0.5)
                if s.lastHp ~= hp then s.hpTxt.Text = hp .. " hp" s.lastHp = hp end
                local frac = hum.Health / math.max(hum.MaxHealth, 1)
                s.hpTxt.Position = Vector2.new(headSP.X, headSP.Y)
                s.hpTxt.Size = cfg.TextSize - 2
                s.hpTxt.Color = Color3.fromHSV(0.33 * frac, 0.8, 1)
                s.hpTxt.Transparency = tA
                s.hpTxt.Visible = true
            else
                s.hpTxt.Visible = false
            end

            if cfg.ShowDistance and feetSP.Z > 0 then
                local d = math.floor(dist)
                if s.lastDist ~= d then s.dist.Text = d .. "m" s.lastDist = d end
                s.dist.Position = Vector2.new(feetSP.X, feetSP.Y + 1)
                s.dist.Size = cfg.TextSize - 2
                s.dist.Color = Color3.fromRGB(180, 180, 195)
                s.dist.Transparency = tA
                s.dist.Visible = true
            else
                s.dist.Visible = false
            end

            if cfg.ShowTool and feetSP.Z > 0 then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    local tn = tool.Name
                    if s.lastTool ~= tn then s.tool.Text = "[" .. tn .. "]" s.lastTool = tn end
                    s.tool.Position = Vector2.new(feetSP.X, feetSP.Y + (cfg.ShowDistance and 14 or 1))
                    s.tool.Size = cfg.TextSize - 2
                    s.tool.Color = Color3.fromRGB(255, 210, 120)
                    s.tool.Transparency = tA
                    s.tool.Visible = true
                else
                    s.tool.Visible = false
                    s.lastTool = ""
                end
            else
                s.tool.Visible = false
            end

            if cfg.TracerStyle ~= "Off" then
                local from
                if cfg.TracerStyle == "Bottom" then
                    from = Vector2.new(vp.X * 0.5, vp.Y)
                elseif cfg.TracerStyle == "Top" then
                    from = Vector2.new(vp.X * 0.5, 0)
                else
                    local m = UIS:GetMouseLocation()
                    from = Vector2.new(m.X, m.Y)
                end
                s.tracer.From = from
                s.tracer.To = Vector2.new(rootSP.X, rootSP.Y)
                s.tracer.Color = col
                s.tracer.Thickness = cfg.TracerThickness
                s.tracer.Transparency = alpha(cfg.TracerTransparency)
                s.tracer.Visible = true
            else
                s.tracer.Visible = false
            end
        end
    else
        for _, s in pairs(espStore) do hide(s) end
    end

    --===== OBJECT ESP =====
    if cfg.ObjectESP and HAS_DRAWING then
        for obj, data in pairs(objects) do
            local part = data.part
            if not part or not part.Parent then
                destroyObj(obj)
                continue
            end

            local show = (data.kind == "mine" and cfg.ShowLandmines) or (data.kind == "remote" and cfg.ShowRemotes)
            if not show then
                hideObj(objStore[obj])
                continue
            end

            local s = objStore[obj] or buildObj(obj)
            local pos = part.Position
            local dist = myHrp and (myHrp.Position - pos).Magnitude or (camPos - pos).Magnitude

            if dist > cfg.ObjectMaxDist then
                hideObj(s)
                continue
            end

            local sp, onScreen = Camera:WorldToViewportPoint(pos)
            if sp.Z < 1 or not onScreen then
                hideObj(s)
                continue
            end

            local scale = 180 / sp.Z
            local size = math.clamp(28 * scale, 8, 55)
            local x = sp.X - size * 0.5
            local y = sp.Y - size * 0.5

            local col = data.kind == "mine" and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(255, 170, 40)

            s.box.Size = Vector2.new(size, size)
            s.box.Position = Vector2.new(x, y)
            s.box.Color = col
            s.box.Visible = true

            s.name.Text = obj.Name
            s.name.Position = Vector2.new(sp.X, y - cfg.ObjectTextSize - 2)
            s.name.Size = cfg.ObjectTextSize
            s.name.Color = col
            s.name.Visible = true

            s.dist.Text = math.floor(dist) .. "m"
            s.dist.Position = Vector2.new(sp.X, y + size + 2)
            s.dist.Size = cfg.ObjectTextSize - 2
            s.dist.Color = Color3.fromRGB(200, 200, 210)
            s.dist.Visible = true
        end
    else
        for _, s in pairs(objStore) do hideObj(s) end
    end
end)

