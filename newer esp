local HAS_DRAWING = (type(Drawing) == "table" and type(Drawing.new) == "function")
local FONT = 2
if HAS_DRAWING then pcall(function() FONT = Drawing.Fonts.Plex end) end

local function newDraw(c, p)
    if not HAS_DRAWING then return nil end
    local ok, o = pcall(Drawing.new, c)
    if not ok or not o then return nil end
    if p then for k, v in pairs(p) do pcall(function() o[k] = v end) end end
    return o
end
local function killDraw(o)
    if not o then return end
    pcall(function() o:Remove() end) pcall(function() o:Destroy() end)
end
local function alpha(t) return math.clamp(1 - t / 100, 0, 1) end

local espStore = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = false

local function isVisible(char)
    if not cfg.UseVisibility then return true end
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not Camera then return false end
    local origin = Camera.CFrame.Position
    rayParams.FilterDescendantsInstances = {LP.Character, char}
    return workspace:Raycast(origin, hrp.Position - origin, rayParams) == nil
end

local function getBox(char, hrp)
    local ok, s = pcall(function() return char:GetExtentsSize() end)
    local size = (ok and s) or Vector3.new(4, 6, 2)
    local top = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, size.Y / 2 + 0.35, 0))
    local bot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, size.Y / 2, 0))
    if top.Z <= 0 or bot.Z <= 0 then return nil end
    local h = math.abs(bot.Y - top.Y)
    if h < 3 then return nil end
    local halfW = math.max(size.X, size.Z) * 0.5
    local r = Camera:WorldToViewportPoint(hrp.Position + Camera.CFrame.RightVector * halfW)
    local l = Camera:WorldToViewportPoint(hrp.Position - Camera.CFrame.RightVector * halfW)
    local w = math.abs(r.X - l.X)
    if w ~= w or w < 4 then w = h * 0.5 end
    return top.X, math.min(top.Y, bot.Y), w, h
end

local function colorFor(plr, vis)
    local base
    if cfg.ColorMode == "Custom" then
        base = cfg.CustomColor
    elseif plr.Team then
        base = plr.TeamColor.Color
    else
        base = Color3.fromRGB(255, 255, 255)
    end
    if cfg.UseVisibility and vis == false then
        return Color3.fromRGB(255, 85, 85)
    end
    return base
end

local function buildState(plr)
    local s = {corner = {}}
    for i = 1, 4 do s.corner[i] = newDraw("Line", {Visible = false}) end
    s.box    = newDraw("Square", {Filled = false, Visible = false})
    s.hpBack = newDraw("Square", {Filled = true, Color = Color3.fromRGB(10, 10, 12), Visible = false})
    s.hpFill = newDraw("Square", {Filled = true, Visible = false})
    s.name   = newDraw("Text", {Center = true, Outline = true, Visible = false})
    s.hpTxt  = newDraw("Text", {Center = true, Outline = true, Visible = false})
    s.dist   = newDraw("Text", {Center = true, Outline = true, Visible = false})
    s.tool   = newDraw("Text", {Center = true, Outline = true, Visible = false})
    s.tracer = newDraw("Line", {Visible = false})
    s.chams = Instance.new("Highlight")
    s.chams.Name = "_nexus_chams"
    s.chams.DepthMode = cfg.ChamsThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    s.chams.Enabled = false
    espStore[plr] = s
    return s
end

local function hide(s)
    if not s then return end
    for i = 1, 4 do if s.corner[i] then s.corner[i].Visible = false end end
    for _, k in ipairs({"box", "hpBack", "hpFill", "name", "hpTxt", "dist", "tool", "tracer"}) do
        if s[k] then s[k].Visible = false end
    end
    s.chams.Enabled = false
end

local function destroyState(plr)
    local s = espStore[plr]
    if not s then return end
    for i = 1, 4 do killDraw(s.corner[i]) end
    for _, k in ipairs({"box", "hpBack", "hpFill", "name", "hpTxt", "dist", "tool", "tracer"}) do
        killDraw(s[k])
    end
    pcall(function() s.chams:Destroy() end)
    espStore[plr] = nil
end

local function drawCorners(x, y, w, h, len, col, a, th, s)
    local cs = {
        {x, y, x + len, y, x, y, x, y + len},
        {x + w - len, y, x + w, y, x + w, y, x + w, y + len},
        {x, y + h - len, x, y + h, x, y + h, x + len, y + h},
        {x + w - len, y + h, x + w, y + h, x + w, y + h - len, x + w, y + h},
    }
    for ci, cd in ipairs(cs) do
        for li = 1, 2 do
            local line = s.corner[(ci - 1) * 2 + li]
            if line then
                local i2 = (li - 1) * 2 + 1
                line.From = Vector2.new(cd[i2], cd[i2 + 1])
                line.To = Vector2.new(cd[i2 + 2], cd[i2 + 3])
                line.Color = col line.Thickness = th line.Transparency = a line.Visible = true
            end
        end
    end
end

local rayTimer = 0
RunService.RenderStepped:Connect(function(dt)
    if not Camera or Camera.Parent == nil then
        Camera = workspace.CurrentCamera
        if not Camera then return end
    end
    rayTimer = rayTimer + dt
    local doRay = rayTimer >= 1 / 15
    if doRay then rayTimer = 0 end

    local vp = Camera.ViewportSize
    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local s = espStore[plr] or buildState(plr)
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if not cfg.Enabled or not char or not hum or not hrp or hum.Health <= 0
                or not char.Parent
                or (cfg.TeamCheck and LP.Team ~= nil and plr.Team == LP.Team) then
                hide(s)
            else
                local dist = myHrp and (myHrp.Position - hrp.Position).Magnitude
                    or (Camera.CFrame.Position - hrp.Position).Magnitude
                if dist > cfg.MaxDistance then hide(s) else
                    local bx, by, bw, bh = getBox(char, hrp)
                    if not bx then hide(s) else
                        if doRay then s.lastVis = isVisible(char) end
                        local col = colorFor(plr, s.lastVis)
                        local a = alpha(cfg.BoxTransparency)

                        local chA = alpha(cfg.ChamsTransparency)
                        if cfg.Chams and chA > 0 then
                            if s.chams.Parent ~= char then s.chams.Parent = char end
                            s.chams.Adornee = char
                            s.chams.FillColor = col
                            s.chams.OutlineColor = col
                            s.chams.FillTransparency = chA
                            s.chams.OutlineTransparency = math.max(chA - 0.35, 0)
                            s.chams.Enabled = true
                        else
                            s.chams.Enabled = false
                        end

                        if HAS_DRAWING then
                            if cfg.BoxStyle == "Corner" then
                                drawCorners(bx, by, bw, bh, math.max(bw, bh) * 0.2, col, a, cfg.BoxThickness, s)
                                s.box.Visible = false
                            elseif cfg.BoxStyle == "Full" then
                                s.box.Size = Vector2.new(bw, bh)
                                s.box.Position = Vector2.new(bx, by)
                                s.box.Color = col
                                s.box.Thickness = cfg.BoxThickness
                                s.box.Transparency = a
                                s.box.Visible = true
                                for i = 1, 4 do s.corner[i].Visible = false end
                            else
                                s.box.Visible = false
                                for i = 1, 4 do s.corner[i].Visible = false end
                            end

                            if cfg.ShowHealth then
                                local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                                local barW = 3
                                local barX = bx - barW - 4
                                s.hpBack.Size = Vector2.new(barW, bh)
                                s.hpBack.Position = Vector2.new(barX, by)
                                s.hpBack.Transparency = math.min(a + 0.4, 1)
                                s.hpBack.Visible = true
                                s.hpFill.Size = Vector2.new(barW, bh * frac)
                                s.hpFill.Position = Vector2.new(barX, by + bh * (1 - frac))
                                s.hpFill.Color = Color3.fromHSV(0.33 * frac, 0.9, 1)
                                s.hpFill.Transparency = a
                                s.hpFill.Visible = true
                            else
                                s.hpBack.Visible = false s.hpFill.Visible = false
                            end

                            local tA = alpha(cfg.TextTransparency)
                            local cx = bx + bw / 2
                            local headY = by - cfg.TextSize - 6

                            if cfg.ShowName then
                                s.name.Text = plr.DisplayName
                                s.name.Position = Vector2.new(cx, headY)
                                s.name.Size = cfg.TextSize
                                s.name.Color = col
                                s.name.Transparency = tA
                                s.name.Font = FONT
                                s.name.Visible = true
                            else s.name.Visible = false end

                            if cfg.ShowHealth then
                                local frac = hum.Health / math.max(hum.MaxHealth, 1)
                                s.hpTxt.Text = string.format("%d hp", math.floor(hum.Health + 0.5))
                                s.hpTxt.Position = Vector2.new(cx, headY + cfg.TextSize + 2)
                                s.hpTxt.Size = cfg.TextSize - 2
                                s.hpTxt.Color = Color3.fromHSV(0.33 * frac, 0.85, 1)
                                s.hpTxt.Transparency = tA
                                s.hpTxt.Font = FONT
                                s.hpTxt.Visible = true
                            else s.hpTxt.Visible = false end

                            if cfg.ShowDistance then
                                s.dist.Text = math.floor(dist) .. "m"
                                s.dist.Position = Vector2.new(cx, by + bh + 4)
                                s.dist.Size = cfg.TextSize - 2
                                s.dist.Color = Color3.fromRGB(190, 190, 205)
                                s.dist.Transparency = tA
                                s.dist.Font = FONT
                                s.dist.Visible = true
                            else s.dist.Visible = false end

                            if cfg.ShowTool then
                                local tool = char:FindFirstChildOfClass("Tool")
                                if tool then
                                    s.tool.Text = "[" .. tool.Name .. "]"
                                    s.tool.Position = Vector2.new(cx, by + bh + (cfg.ShowDistance and 19 or 4))
                                    s.tool.Size = cfg.TextSize - 2
                                    s.tool.Color = Color3.fromRGB(255, 220, 130)
                                    s.tool.Transparency = tA
                                    s.tool.Font = FONT
                                    s.tool.Visible = true
                                else s.tool.Visible = false end
                            else s.tool.Visible = false end

                            if cfg.TracerStyle ~= "Off" then
                                local from
                                if cfg.TracerStyle == "Bottom" then from = Vector2.new(vp.X / 2, vp.Y)
                                elseif cfg.TracerStyle == "Top" then from = Vector2.new(vp.X / 2, 0)
                                else local m = UIS:GetMouseLocation() from = Vector2.new(m.X, m.Y) end
                                s.tracer.From = from
                                s.tracer.To = Vector2.new(cx, by + bh)
                                s.tracer.Color = col
                                s.tracer.Thickness = cfg.TracerThickness
                                s.tracer.Transparency = alpha(cfg.TracerTransparency)
                                s.tracer.Visible = true
                            else s.tracer.Visible = false end
                        end
                    end
                end
            end
        end
    end
end)

