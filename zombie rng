local function expandHitbox(model)
    if not model or model:GetAttribute("NexusExpanded") then return end
    model:SetAttribute("NexusExpanded", true)

    local size = 126 -- try bigger

    local parts = {"HumanoidRootPart", "Torso", "Head", "LeftArm", "RightArm", "LeftLeg", "RightLeg"}
    for _, name in ipairs(parts) do
        local part = model:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            if not part:GetAttribute("OriginalSize") then
                part:SetAttribute("OriginalSize", part.Size)
            end
            part.Size = Vector3.new(size, size * 0.8, size)
            part.Transparency = 0.5
            part.Color = Color3.fromRGB(255, 30, 30)
            part.CanCollide = false
        end
    end
end
