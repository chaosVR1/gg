--================ SETTINGS ================
local cfg = {
    -- Hitbox
    HitboxEnabled = true,
    HitboxSize = 14,
    HitboxColor = Color3.fromRGB(255, 50, 50),
    HitboxTransparency = 0.6,

    -- ESP
    ESPEnabled = true,
    ESPColor = Color3.fromRGB(0, 255, 128),
    ShowName = true,
    ShowDistance = true,
    ShowBox = true,
    MaxESPDistance = 800,

    -- Speed
    SpeedEnabled = false,
    SpeedMultiplier = 1.8,

    MenuKey = Enum.KeyCode.RightShift,
}

local TargetNames = {
    "UndeadGuest", "UndeadNoob", "UndeadNinja",
    "UndeadPirate", "Zombie", "Irradiator"
}

--================ OPTIMIZED TARGET CACHE ================
local targets = {}          -- [model] = {hrp, hum, hitbox}
local lastScan = 0
local SCAN_INTERVAL = 1.25

local function isTarget(name)
    for _, n in ipairs(TargetNames) do
        if name == n or name:find(n) then return true end
    end
    return false
end

local function createHitbox(model, hrp)
    if model:FindFirstChild("NexusHitbox") then return model.NexusHitbox end

    local hitbox = Instance.new("Part")
    hitbox.Name = "NexusHitbox"
    hitbox.Anchored = false
    hitbox.CanCollide = false
    hitbox.Massless = true
    hitbox.Material = Enum.Material.ForceField
    hitbox.Parent = model

    local weld = Instance.new("Weld")
    weld.Part0 = hrp
    weld.Part1 = hitbox
    weld.Parent = hitbox

    return hitbox
end

local function scanTargets()
    local found = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isTarget(obj.Name) then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                found[obj] = {
                    hrp = hrp,
                    hum = hum,
                    hitbox = obj:FindFirstChild("NexusHitbox")
                }
            end
        end
    end

    -- Remove old
    for model in pairs(targets) do
        if not found[model] then
            local old = model:FindFirstChild("NexusHitbox")
            if old then old:Destroy() end
            targets[model] = nil
        end
    end

    targets = found
end

--================ ESP DRAWINGS ================
local drawings = {}  -- [model] = {box, name, dist}

local function getDrawing(model)
    if drawings[model] then return drawings[model] end

    local t = {
        box  = Drawing.new("Square"),
        name = Drawing.new("Text"),
        dist = Drawing.new("Text"),
    }

    t.box.Thickness = 1.2
    t.box.Filled = false
    t.box.Visible = false

    t.name.Center = true
    t.name.Outline = true
    t.name.Size = 14
    t.name.Visible = false

    t.dist.Center = true
    t.dist.Outline = true
    t.dist.Size = 12
    t.dist.Visible = false

    drawings[model] = t
    return t
end

local function hideDrawing(t)
    if not t then return end
    t.box.Visible = false
    t.name.Visible = false
    t.dist.Visible = false
end

local function destroyDrawing(model)
    local t = drawings[model]
    if not t then return end
    pcall(function() t.box:Remove() end)
    pcall(function() t.name:Remove() end)
    pcall(function() t.dist:Remove() end)
    drawings[model] = nil
end

--================ MAIN LOOP ================
local myHRP, myHum
local speedConn

local function updateSpeed()
    if speedConn then speedConn:Disconnect() speedConn = nil end
    if not cfg.SpeedEnabled then return end

    speedConn = RunService.Heartbeat:Connect(function()
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16 * cfg.SpeedMultiplier
        end
    end)
end

RunService.Heartbeat:Connect(function()
    -- Cache character
    local char = LP.Character
    myHRP = char and char:FindFirstChild("HumanoidRootPart")
    myHum = char and char:FindFirstChildOfClass("Humanoid")

    -- Scan targets every interval
    if tick() - lastScan > SCAN_INTERVAL then
        lastScan = tick()
        scanTargets()
    end

    local camPos = Camera.CFrame.Position

    for model, data in pairs(targets) do
        local hrp = data.hrp
        local hum = data.hum

        if not hrp or not hrp.Parent or not hum or hum.Health <= 0 then
            destroyDrawing(model)
            targets[model] = nil
            continue
        end

        --====== HITBOX ======
        if cfg.HitboxEnabled then
            local hitbox = data.hitbox or createHitbox(model, hrp)
            data.hitbox = hitbox

            local size = cfg.HitboxSize
            hitbox.Size = Vector3.new(size, size, size)
            hitbox.Color = cfg.HitboxColor
            hitbox.Transparency = cfg.HitboxTransparency
        else
            if data.hitbox then
                data.hitbox:Destroy()
                data.hitbox = nil
            end
        end

        --====== ESP ======
        if cfg.ESPEnabled and myHRP then
            local dist = (myHRP.Position - hrp.Position).Magnitude
            if dist > cfg.MaxESPDistance then
                hideDrawing(drawings[model])
                continue
            end

            local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if not onScreen or sp.Z < 0 then
                hideDrawing(drawings[model])
                continue
            end

            local t = getDrawing(model)
            local col = cfg.ESPColor

            -- Box
            if cfg.ShowBox then
                local scale = 60 / sp.Z
                local w = 28 * scale
                local h = 42 * scale
                t.box.Size = Vector2.new(w, h)
                t.box.Position = Vector2.new(sp.X - w/2, sp.Y - h/2)
                t.box.Color = col
                t.box.Visible = true
            else
                t.box.Visible = false
            end

            -- Name
            if cfg.ShowName then
                t.name.Text = model.Name
                t.name.Position = Vector2.new(sp.X, sp.Y - 28)
                t.name.Color = col
                t.name.Visible = true
            else
                t.name.Visible = false
            end

            -- Distance
            if cfg.ShowDistance then
                t.dist.Text = math.floor(dist) .. "m"
                t.dist.Position = Vector2.new(sp.X, sp.Y + 18)
                t.dist.Color = Color3.fromRGB(200, 200, 210)
                t.dist.Visible = true
            else
                t.dist.Visible = false
            end
        else
            hideDrawing(drawings[model])
        end
    end
end)

