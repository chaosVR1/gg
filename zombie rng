--// ═══════════════════════════════════════════════════
--//   Undead Hitbox Expander + Kill Aura
--// ═══════════════════════════════════════════════════

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

--================ SETTINGS ================
local Settings = {
    HitboxSize = Vector3.new(14, 14, 14),   -- Size of expanded hitbox
    HitboxTransparency = 0.65,             -- 0 = invisible, 1 = solid
    ShowHitbox = true,                     -- Show the red hitbox

    KillAura = true,                       -- Auto attack when in range
    AuraRange = 22,                        -- How close to attack
    AttackSpeed = 0.12,                    -- Lower = faster attacks
}

local TargetNames = {
    "UndeadGuest",
    "UndeadNoob",
    "UndeadNinja",
    "UndeadPirate",
    "Zombie",
    "Irradiator"
}

--================ HITBOX EXPANDER ================
local function expandHitbox(model)
    if not model or not model:FindFirstChild("HumanoidRootPart") then return end
    if model:FindFirstChild("NexusHitbox") then return end

    local hrp = model.HumanoidRootPart

    local hitbox = Instance.new("Part")
    hitbox.Name = "NexusHitbox"
    hitbox.Size = Settings.HitboxSize
    hitbox.Transparency = Settings.ShowHitbox and Settings.HitboxTransparency or 1
    hitbox.CanCollide = false
    hitbox.Massless = true
    hitbox.Anchored = false
    hitbox.Color = Color3.fromRGB(255, 40, 40)
    hitbox.Material = Enum.Material.ForceField
    hitbox.Parent = model

    local weld = Instance.new("Weld")
    weld.Part0 = hrp
    weld.Part1 = hitbox
    weld.Parent = hitbox
end

task.spawn(function()
    while true do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") then
                for _, name in ipairs(TargetNames) do
                    if obj.Name == name or obj.Name:find(name) then
                        expandHitbox(obj)
                        break
                    end
                end
            end
        end
        task.wait(1.2)
    end
end)

--================ KILL AURA (No walking) ================
task.spawn(function()
    while true do
        if Settings.KillAura then
            local myChar = LP.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tool = myChar and myChar:FindFirstChildOfClass("Tool")

            if myHRP and tool then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                        for _, name in ipairs(TargetNames) do
                            if (obj.Name == name or obj.Name:find(name)) then
                                local hum = obj:FindFirstChildOfClass("Humanoid")
                                if hum and hum.Health > 0 then
                                    local dist = (myHRP.Position - obj.HumanoidRootPart.Position).Magnitude
                                    if dist <= Settings.AuraRange then
                                        tool:Activate()
                                    end
                                end
                                break
                            end
                        end
                    end
                end
            end
        end
        task.wait(Settings.AttackSpeed)
    end
end)

print("[NEXUS] Hitbox Expander + Kill Aura loaded (no walking)")
